<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coleção de Cartas - One Piece TCG</title>
    
    <!-- Google Fonts (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS & Ícones -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        :root {
            --bg-body: #0a0f1e;
            --bg-panel: rgba(16, 24, 45, 0.85);
            --bg-card: rgba(22, 34, 61, 0.65);
            --border-color: rgba(255, 255, 255, 0.08);
            --primary-gold: #f59e0b;
            --primary-gold-hover: #d97706;
            --text-main: #f1f5f9;
            --text-subtle: #cbd5e1; /* Cor mais clara para labels e subtextos */
            
            /* Cores para os Preços */
            --price-market: #3b82f6;
            --price-min: #10b981;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
        }

        /* Navbar Clean */
        .navbar-custom {
            background: rgba(10, 15, 30, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-color);
        }
        .brand-logo { font-weight: 700; color: var(--primary-gold); letter-spacing: -0.5px; }
        
        /* Corrigido: Nome de usuário visível na navbar */
        .user-greeting {
            color: var(--text-subtle) !important;
            font-size: 0.9rem;
        }
        .user-name-highlight {
            color: var(--text-main) !important;
            font-weight: 600;
        }

        /* Glass Panel */
        .glass-panel {
            background: var(--bg-panel);
            backdrop-filter: blur(8px);
            border: 1px solid var(--border-color);
            border-radius: 12px;
        }

        /* Corrigido: Labels dos formulários e switches */
        .text-form-label {
            color: var(--text-subtle) !important;
            font-weight: 500;
            font-size: 0.85rem;
        }

        /* Inputs Custom */
        .form-control-custom, .form-select-custom {
            background-color: rgba(10, 15, 30, 0.7) !important;
            border: 1px solid var(--border-color) !important;
            color: var(--text-main) !important;
            border-radius: 6px !important;
        }
        .form-control-custom:focus, .form-select-custom:focus {
            border-color: var(--primary-gold) !important;
            box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.15) !important;
        }
        .form-control-custom::placeholder {
            color: rgba(255, 255, 255, 0.3) !important;
        }

        /* Botões */
        .btn-gold { background-color: var(--primary-gold); color: #000; font-weight: 600; border: none; border-radius: 6px; }
        .btn-gold:hover { background-color: var(--primary-gold-hover); color: #000; }
        
        /* Badges */
        .badge-custom { font-weight: 600; font-size: 0.7rem; padding: 0.3em 0.5em; border-radius: 4px; }
        .badge-code { background-color: rgba(255, 255, 255, 0.12); color: #06b6d4; }
        .badge-foil { background: linear-gradient(135deg, #f59e0b, #ec4899); color: #fff; }
        .badge-aa { background: linear-gradient(135deg, #8b5cf6, #3b82f6); color: #fff; }

        /* Cartas na Lista */
        .list-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; transition: all 0.2s; }
        .list-card:hover { border-color: rgba(245, 158, 11, 0.3); background: rgba(22, 34, 61, 0.9); }
        .card-img-thumb { width: 60px; height: 84px; object-fit: cover; border-radius: 6px; cursor: pointer; }
        .card-img-thumb:hover { transform: scale(1.05); box-shadow: 0 0 8px var(--primary-gold); }

        /* Preços */
        .price-tag {
            font-weight: 500;
            font-size: 0.8rem;
            display: inline-block;
        }
        .price-label {
            color: var(--text-subtle);
            margin-right: 2px;
        }

        /* Switch Customizado */
        .form-check-input {
            background-color: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.2);
            cursor: pointer;
        }
        .form-check-input:checked {
            background-color: var(--primary-gold);
            border-color: var(--primary-gold);
        }

        /* Modal de Zoom */
        .modal-zoom .modal-content { background: transparent; border: none; }
        .modal-zoom.modal-backdrop.show { backdrop-filter: blur(15px); background-color: rgba(0, 0, 0, 0.8); opacity: 1; }
        .modal-zoom .modal-body { display: flex; justify-content: center; align-items: center; padding: 0; }
        .img-zoom-result { max-height: 85vh; border-radius: 12px; box-shadow: 0 10px 50px rgba(0,0,0,0.8); }
        .btn-close-zoom { position: fixed; top: 20px; right: 20px; z-index: 1060; background-color: #fff; border-radius: 50%; padding: 10px; }
    </style>
</head>
<body class="pb-5">

    <!-- NAVBAR -->
    <nav class="navbar navbar-custom mb-4 sticky-top">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <span class="navbar-brand mb-0 h1 brand-logo d-flex align-items-center gap-2">
                <i class="bi bi-compass text-warning"></i> OPTCG Collection
            </span>
            <div class="d-flex align-items-center gap-3">
                <!-- Nome de usuário com contraste corrigido -->
                <span class="user-greeting">Olá, <strong class="user-name-highlight"><%= userName %></strong></span>
                <a href="/logout" class="btn btn-sm btn-outline-danger border-0" title="Sair"><i class="bi bi-box-arrow-right fs-5"></i></a>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4">
        <div class="row g-4">
            
            <!-- SIDEBAR: CADASTRO E FILTROS -->
            <div class="col-lg-3 col-md-4">
                
                <!-- CADASTRO MANUAL -->
                <div class="glass-panel p-3 mb-4">
                    <h6 class="text-warning fw-bold mb-3"><i class="bi bi-pencil-square me-2"></i>Cadastro Manual</h6>
                    <form action="/adicionar" method="POST" class="row g-2">
                        <div class="col-12">
                            <input type="text" name="idCard" class="form-control form-control-custom form-control-sm" placeholder="Ex: OP01-016" required>
                        </div>
                        <div class="col-6">
                            <input type="number" name="quantidade" class="form-control form-control-custom form-control-sm" value="1" min="1" placeholder="Qtd">
                        </div>
                        <div class="col-6">
                            <button type="submit" class="btn btn-gold btn-sm w-100">Adicionar</button>
                        </div>
                        
                        <!-- Switches com labels visíveis -->
                        <div class="col-6 mt-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="isFoil" id="manualFoil">
                                <label class="form-check-label text-form-label" for="manualFoil">Foil</label>
                            </div>
                        </div>
                        <div class="col-6 mt-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="isAlternateArt" id="manualAA">
                                <label class="form-check-label text-form-label" for="manualAA">Arte Alt.</label>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- PAINEL DE FILTROS (PESQUISA) -->
                <div class="glass-panel p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-white fw-bold mb-0"><i class="bi bi-search me-2"></i>Filtros de Pesquisa</h6>
                        <a href="/" class="btn btn-sm btn-link text-warning p-0 text-decoration-none small">Limpar</a>
                    </div>
                    <form action="/" method="GET" class="row g-2">
                        
                        <!-- Categoria -->
                        <div class="col-12">
                            <label class="text-form-label mb-1">Categoria</label>
                            <select name="tipo" class="form-select form-select-custom form-select-sm" onchange="this.form.submit()">
                                <option value="">Todas</option>
                                <option value="Leader">Leader</option>
                                <option value="Character">Character</option>
                                <option value="Event">Event</option>
                                <option value="Stage">Stage</option>
                                <option value="DON!!">DON!!</option>
                            </select>
                        </div>

                        <!-- Cor -->
                        <div class="col-12">
                            <label class="text-form-label mb-1">Cor</label>
                            <select name="cor" class="form-select form-select-custom form-select-sm" onchange="this.form.submit()">
                                <option value="">Todas</option>
                                <option value="Red" style="color: #ef4444;">Red</option>
                                <option value="Blue" style="color: #3b82f6;">Blue</option>
                                <option value="Green" style="color: #22c55e;">Green</option>
                                <option value="Black" style="color: #f1f5f9;">Black</option>
                                <option value="Purple" style="color: #a855f7;">Purple</option>
                                <option value="Yellow" style="color: #eab308;">Yellow</option>
                                <option value="Multicolor">Multicolor</option>
                            </select>
                        </div>

                        <!-- Filtros por acabamento -->
                        <div class="col-12 mt-3">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="apenasFoil" id="filterFoil" value="true" onchange="this.form.submit()">
                                <label class="form-check-label text-form-label" for="filterFoil">Apenas Foil</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="apenasAA" id="filterAA" value="true" onchange="this.form.submit()">
                                <label class="form-check-label text-form-label" for="filterAA">Apenas AA</label>
                            </div>
                        </div>

                    </form>
                </div>
            </div>

            <!-- ÁREA PRINCIPAL: LISTAGEM DE CARTAS -->
            <div class="col-lg-9 col-md-8">
                
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Sua Coleção</h5>
                    <span class="badge badge-custom badge-code">Total: <%= cartas ? cartas.length : 0 %> cartas</span>
                </div>

                <div class="row g-2">
                    <% if (!cartas || cartas.length === 0) { %>
                        <div class="col-12 text-center text-muted py-5 glass-panel">
                            <i class="bi bi-box-seam fs-2 mb-2 d-block"></i>
                            <p class="mb-0">Nenhuma carta encontrada com os filtros selecionados.</p>
                        </div>
                    <% } else { %>
                        <% cartas.forEach(carta => { %>
                            <div class="col-lg-6 col-xl-4">
                                <div class="list-card p-2 d-flex align-items-center gap-2">
                                    
                                    <!-- Imagem com função de Zoom -->
                                    <img src="<%= carta.imagem || 'https://placehold.co/100x140/1a223d/8492a6?text=Sem+Foto' %>" 
                                         alt="<%= carta.nome %>" 
                                         class="card-img-thumb"
                                         onclick="zoomCarta('<%= carta.imagem || 'https://placehold.co/100x140/1a223d/8492a6?text=Sem+Foto' %>')">
                                    
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <span class="badge badge-custom badge-code"><%= carta.idCard %></span>
                                            <div class="d-flex gap-1">
                                                <% if (carta.isFoil) { %><span class="badge badge-custom badge-foil">Foil</span><% } %>
                                                <% if (carta.isAlternateArt) { %><span class="badge badge-custom badge-aa">AA</span><% } %>
                                            </div>
                                        </div>
                                        <h6 class="text-white text-truncate mb-1" title="<%= carta.nome %>"><%= carta.nome %></h6>
                                        
                                        <!-- Exibição dos Valores -->
                                        <div class="d-flex gap-2 mb-1">
                                            <span class="price-tag" style="color: var(--price-market);">
                                                <span class="price-label">Mkt:</span>
                                                <%= (typeof carta.valorMax !== 'undefined' ? 'R$ ' + carta.valorMax.toFixed(2) : '---') %>
                                            </span>
                                            <span class="price-tag" style="color: var(--price-min);">
                                                <span class="price-label">Mín:</span>
                                                <%= (typeof carta.valorMin !== 'undefined' ? 'R$ ' + carta.valorMin.toFixed(2) : '---') %>
                                            </span>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center mt-1 pt-1 border-top border-secondary border-opacity-25">
                                            <span class="text-warning small fw-bold">Qtd: <%= carta.quantidade %></span>
                                            <a href="/deletar/<%= carta._id %>" class="btn btn-sm btn-link text-danger p-0 h-auto" onclick="return confirm('Excluir esta carta?')"><i class="bi bi-trash"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL DE ZOOM DA CARTA -->
    <div class="modal fade modal-zoom" id="modalZoom" tabindex="-1" aria-hidden="true">
        <button type="button" class="btn-close btn-close-zoom" data-bs-dismiss="modal" aria-label="Close"></button>
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-body">
                    <img src="" id="imgZoomTarget" class="img-zoom-result" alt="Zoom Carta">
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function zoomCarta(url) {
            const imgTarget = document.getElementById('imgZoomTarget');
            imgTarget.src = url;
            const modalZoom = new bootstrap.Modal(document.getElementById('modalZoom'));
            modalZoom.show();
        }

        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            
            const tipo = urlParams.get('tipo');
            if(tipo) document.querySelector('select[name="tipo"]').value = tipo;
            
            const cor = urlParams.get('cor');
            if(cor) document.querySelector('select[name="cor"]').value = cor;

            if(urlParams.get('apenasFoil') === 'true') document.getElementById('filterFoil').checked = true;
            if(urlParams.get('apenasAA') === 'true') document.getElementById('filterAA').checked = true;
        });
    </script>
</body>
</html>