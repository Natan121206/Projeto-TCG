<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Editar Carta</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="container py-5">
    <div class="text-center mb-5">
        <h1>📝 EDITAR CARTA</h1>
        <p class="text-secondary">Atualize as informações da sua <%= carta.nome %></p>
    </div>

    <div class="custom-card mx-auto" style="max-width: 600px;">
        <form action="/editar/<%= carta._id %>" method="POST">
            <div class="mb-3">
                <label class="form-label">ID da Carta</label>
                <input type="text" name="idCard" class="form-control" value="<%= carta.idCard %>" required>
            </div>
            <div class="mb-3">
    <label class="form-label">Quantidade em Estoque</label>
    <input type="number" name="quantidade" class="form-control" value="<%= carta.quantidade || 1 %>">
</div>
            <div class="mb-3">
                <label class="form-label">Nome da Carta</label>
                <input type="text" name="nome" class="form-control" value="<%= carta.nome %>" required>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Valor Mínimo</label>
                    <input type="number" step="0.01" name="valorMin" class="form-control" value="<%= carta.valorMin %>" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Valor Máximo</label>
                    <input type="number" step="0.01" name="valorMax" class="form-control" value="<%= carta.valorMax %>" required>
                </div>
            </div>
            <div class="d-flex justify-content-between mt-4">
                <a href="/" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-warning fw-bold">SALVAR ALTERAÇÕES</button>
            </div>
        </form>
    </div>
</body>
</html>