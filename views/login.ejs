<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Login - OP Deck</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex align-items-center vh-100">
    <div class="container">
        <div class="custom-card mx-auto" style="max-width: 400px;">
            <h2 class="text-center text-warning mb-4">🏴‍☠️ Entrar</h2>
            <form action="/login" method="POST">
                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <input type="email" name="email" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Senha</label>
                    <input type="password" name="password" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-warning w-100 fw-bold mb-3">LOGAR</button>
                <p class="text-center small">Não tem conta? <a href="/registrar" class="text-warning">Cadastre-se</a></p>
            </form>
        </div>
    </div>
</body>
</html>